{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/**"],
        "maxDuration": 30
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/products(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/categories(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/auth(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/cart(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/orders(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/notifications(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/reviews(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/admin(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/health",
      "dest": "backend/server.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|json|map))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
