PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Optional direct replica-set URI if SRV DNS resolution is blocked in serverless
# MONGODB_DIRECT_URI=mongodb://<username>:<password>@shard-00-00.<cluster>.mongodb.net:27017,shard-00-01.<cluster>.mongodb.net:27017,shard-00-02.<cluster>.mongodb.net:27017/<database>?ssl=true&replicaSet=<replica-set-name>&authSource=admin
JWT_SECRET=your_secure_jwt_secret_here
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Comma-separated admin email(s) — users with these emails get admin role automatically
ADMIN_EMAIL=admin@yourdomain.com

# SMTP / Email Service Configuration (Keep secrets secure in deployment environment)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM="ShopEase" <your-email@gmail.com>
